    "989b4b2e6801": {
      "name": "j133 — 추천내역 + ROW_NUMBER PARTITION",
      "imageKey": "j133",
      "refs": [
        {
          "type": "table",
          "caption": "[테이블 : 추천내역]",
          "headers": ["추천경로", "추천인", "피추천인", "추천점수"],
          "rows": [
            ["SNS", "나한일", "강감찬", "75"],
            ["SNS", "이순신", "강감찬", "80"],
            ["이벤트응모", "홍길동", "강감찬", "88"],
            ["이벤트응모", "저절로", "이순신", "78"],
            ["홈페이지", "저절로", "이대로", "93"],
            ["홈페이지", "홍두깨", "심청이", "98"]
          ]
        },
        {
          "type": "sql",
          "caption": "[SQL]",
          "code": "SELECT 추천경로, 추천인, 피추천인, 추천점수\nFROM   (SELECT 추천경로, 추천인, 피추천인, 추천점수\n              ,ROW_NUMBER() OVER(PARTITION BY 추천경로\n                                 ORDER BY 추천점수 DESC) AS RNUM\n        FROM   추천내역)\nWHERE  RNUM = 1;"
        }
      ]
    },
