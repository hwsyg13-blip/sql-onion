            ["12000", ""],
            ["13000", ""],
            ["14000", "3000"],
            ["15000", "4000"],
            ["16000", "4000"]
          ]
        },
        {
          "type": "sql",
          "caption": "[SQL]",
          "code": "SELECT A.고객번호, A.고객명, B.단말기ID, B.단말기명, C.OSID, C.OS명\nFROM   고객 A LEFT OUTER JOIN 단말기 B\nON     (A.고객번호 IN (11000, 12000) AND A.단말기ID = B.단말기ID) LEFT OUTER JOIN OS C\nON     (B.OSID = C.OSID)\nORDER BY A.고객번호;"
        }
