          "caption": "[테이블 : 월별매출]",
          "headers": ["월(PK)", "고객번호(PK)", "매출액"],
          "rows": [
            ["201301", "001", "200"],
            ["201301", "002", "250"],
            ["201301", "003", "200"],
            ["201301", "004", "250"],
            ["201302", "001", "150"],
            ["201302", "002", "100"],
            ["201302", "005", "100"],
            ["201303", "002", "100"],
            ["201303", "003", "150"]
          ]
        },
        {
          "type": "sql",
          "caption": "[SQL]",
          "code": "SELECT 고객번호, 고객명, 매출액\n      ,RANK() OVER(ORDER BY 매출액 DESC) AS 순위\nFROM   (\n        SELECT A.고객번호, A.고객명\n              ,MAX(A.고객명) AS 고객명\n              ,SUM(B.매출액) AS 매출액\n        FROM   고객 A INNER JOIN 월별매출 B\n        ON     (A.고객번호 = B.고객번호)\n        GROUP BY A.고객번호\n       )\nORDER BY RNK;"
        }
      ]
    },
