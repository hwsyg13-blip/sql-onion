          "mermaid": "erDiagram\n    SERVICE ||--o{ SERVICE_USE : provides\n    MEMBER ||--o{ SERVICE_USE : uses\n    SERVICE {\n        string serviceId PK\n        string serviceName\n        string serviceURL\n    }\n    MEMBER {\n        string memberId PK\n        string memberName\n    }\n    SERVICE_USE {\n        string memberId FK\n        string serviceId FK\n        date useDate\n    }"
        },
        {
          "type": "sql",
          "caption": "[수행 SQL]",
          "code": "SELECT A.서비스ID, A.서비스명, B.서비스URL\nFROM   (SELECT 서비스ID\n        FROM   서비스\n        INTERSECT\n        SELECT 서비스ID\n        FROM   서비스이용) A, 서비스 B\nWHERE  A.서비스ID = B.서비스ID;"
        }
