{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/exam/round-:n(\\d+)",
      "destination": "/?cbt=round-:n",
      "permanent": true
    },
    {
      "source": "/exam/round-:n(\\d+)/",
      "destination": "/?cbt=round-:n",
      "permanent": true
    }
  ]
}
